# ATLAS Environment Configuration
# Copy this to .env and fill in your values

# === EXCHANGE ===
EXCHANGE_ID=binance           # or coinbase, kraken
TRADING_PAIR=ETH/USDT
PAPER_TRADING=true

# === API KEYS ===
EXCHANGE_API_KEY=your_key_here
EXCHANGE_API_SECRET=your_secret_here

# === LLM ===
OPENAI_API_KEY=your_openai_key_here
LLM_MODEL=gpt-4o-mini         # or gpt-4o for production

# === DATABASE ===
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/atlas
REDIS_URL=redis://localhost:6379/0

# === REDDIT (PRAW) ===
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_secret
REDDIT_USER_AGENT=atlas-bot/1.0

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === RISK ===
CAPITAL_USD=10000
BASE_RISK_PCT=0.015           # 1.5% per trade
MAX_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=0.05     # 5% halt
CONFIDENCE_THRESHOLD=7.0
